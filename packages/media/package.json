{
  "name": "@flowgraph/media",
  "version": "0.1.0",
  "description": "Media vendor adapters (images, video, 3D, audio) for flowgraph image/video/model3d/audio nodes",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@flowgraph/core": "workspace:*"
  },
  "devDependencies": {
    "@flowgraph/core": "workspace:*",
    "@flowgraph/spec": "workspace:*",
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  }
}
