{
  "name": "@flowgraph/media",
  "version": "0.1.0",
  "description": "Preview: generative media nodes (`image`, `video`, `model3d`, `audio`), `kind: media` provider config, and vendor adapters for flowgraph",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@flowgraph/core": "workspace:^",
    "@flowgraph/spec": "workspace:^"
  },
  "dependencies": {
    "@flowgraph/expr": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@flowgraph/core": "workspace:*",
    "@flowgraph/node-demo": "workspace:*",
    "@flowgraph/node-workshop": "workspace:*",
    "@flowgraph/spec": "workspace:*",
    "@langchain/langgraph": "^1.4.7",
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  }
}
