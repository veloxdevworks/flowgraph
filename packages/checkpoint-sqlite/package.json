{
  "name": "@flowgraph/checkpoint-sqlite",
  "version": "0.1.0",
  "description": "Durable SQLite checkpointer and scoped memory backend for flowgraph",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "better-sqlite3": "^12.11.1"
  },
  "peerDependencies": {
    "@langchain/langgraph": "^1.4.7",
    "@flowgraph/core": "workspace:^"
  },
  "devDependencies": {
    "@flowgraph/core": "workspace:*",
    "@langchain/langgraph": "^1.4.7",
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "@flowgraph/testing": "workspace:*"
  }
}
