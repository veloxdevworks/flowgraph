{
  "name": "@flowgraph/cli",
  "version": "0.1.0",
  "description": "CLI for flowgraph",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "flowgraph": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flowgraph/core": "workspace:*",
    "@flowgraph/expr": "workspace:*",
    "@flowgraph/media": "workspace:*",
    "@flowgraph/node-demo": "workspace:*",
    "@flowgraph/node-port": "workspace:*",
    "@flowgraph/node-service": "workspace:*",
    "@flowgraph/node-workshop": "workspace:*",
    "@flowgraph/node-worktree": "workspace:*",
    "@flowgraph/skills": "workspace:*",
    "@flowgraph/spec": "workspace:*",
    "@flowgraph/tools-fs": "workspace:*",
    "@flowgraph/workshop-session": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@flowgraph/checkpoint-sqlite": "workspace:*",
    "@flowgraph/checkpoint-postgres": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@flowgraph/checkpoint-sqlite": {
      "optional": true
    },
    "@flowgraph/checkpoint-postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flowgraph/checkpoint-sqlite": "workspace:*",
    "@flowgraph/checkpoint-postgres": "workspace:*",
    "@flowgraph/provider-claude": "workspace:*",
    "@flowgraph/provider-cursor": "workspace:*",
    "@flowgraph/provider-deepagents": "workspace:*",
    "@types/node": "^26.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "pg": "^8.12.0",
    "@types/pg": "^8.11.0"
  }
}
