{
  "name": "@flowgraph/node-demo",
  "version": "0.1.0",
  "description": "Preview: artifact capture and scripted verification node (`demo`) for flowgraph",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@flowgraph/core": "workspace:*"
  },
  "dependencies": {
    "@flowgraph/expr": "workspace:*",
    "@flowgraph/spec": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@flowgraph/core": "workspace:*",
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  }
}
